# ── Sunny HRM — конфігурація (скопіюйте у .env, заповніть, .env не комітимо) ──
# PostgreSQL: суперюзер (для міграцій) і окрема роль застосунку (для RLS)
POSTGRES_DB=sunny_hrm
POSTGRES_USER=hrm_admin
POSTGRES_PASSWORD=CHANGE_me_admin_pw
APP_DB_USER=hrm_app
APP_DB_PASSWORD=CHANGE_me_app_pw

# Бекенд
NODE_ENV=production
APP_ENV=production
DEMO_SEED=false
APP_URL=https://hr.sunny.ua
SESSION_SECRET=CHANGE_me_long_random_string
PORT=3000

# Вхід через Google (опційно). Пошта НЕ обмежена доменом — самореєстрація
# і вхід поштою/паролем працюють без жодного налаштування Google.
# Створення Client ID безкоштовне (без білінгу), достатньо звичайного акаунта.
GOOGLE_CLIENT_ID=

# ШІ-помічник і оцінка резюме кандидатів (опційно). Без жодного ключа ці
# функції просто показують дружнє повідомлення замість помилки — решта
# системи працює як звичайно.
# Варіант 1 (рекомендовано, безкоштовно назавжди, без картки):
#   Google AI Studio → aistudio.google.com → Get API key.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
# Варіант 2 (опційно, якщо вже є платний доступ до Claude): якщо задано
# GEMINI_API_KEY вище — цей ігнорується, пріоритет завжди в Gemini.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001
# Максимальна довжина відповіді ШІ (у токенах, приблизно 0.75 слова на токен).
# Можна збільшити, якщо відповіді обриваються на середині речення.
AI_CHAT_MAX_TOKENS=2800
AI_REVIEW_MAX_TOKENS=3600

# Пошта (SMTP) — запрошення й відновлення пароля.
# Для звичайного Gmail: SMTP_HOST=smtp.gmail.com, SMTP_USER=ваша адреса,
# SMTP_PASS=пароль застосунку (App Password, не звичайний пароль від акаунта;
# створюється в налаштуваннях безпеки Google після ввімкнення 2FA).
SMTP_HOST=smtp-relay.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=HR Sunny <hr@sunny.ua>

# Домен для Caddy/HTTPS
SITE_DOMAIN=hr.sunny.ua

# Зберігати логи та аудит 12 місяців
SECURITY_LOG_RETENTION_DAYS=365
